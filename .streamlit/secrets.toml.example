# Copy this file to .streamlit/secrets.toml (never commit the real one).
# On Render, paste the same content as a Secret File named secrets.toml
# with mount path /etc/secrets/secrets.toml  (see DEPLOY.md).

TALLY_API_KEY = "tly-..."
TALLY_FORM_ID = "wMxY3k"

# ---------------------------------------------------------------------------
# Who can get in. Emails are matched case-insensitively. Domains let anyone
# with an address there in (e.g. "london.edu").
#   admin    - everything: fetch, read CVs, build teams, upload data, see the log
#   reviewer - include/exclude people, rate, add notes, move people between teams
#   viewer   - read only
# ---------------------------------------------------------------------------
[access]
admins = ["you@london.edu"]
reviewers = []
viewers = []
admin_domains = []
reviewer_domains = []
viewer_domains = []

# Option A (recommended): sign in with Google or Microsoft.
# Fill in ONE provider below and delete the other, or keep both for two buttons.
[auth]
redirect_uri = "https://your-app.onrender.com/oauth2callback"   # http://localhost:8501/oauth2callback locally
cookie_secret = "generate-a-long-random-string"                  # python -c "import secrets; print(secrets.token_hex(32))"

[auth.microsoft]
client_id = "..."
client_secret = "..."
server_metadata_url = "https://login.microsoftonline.com/common/v2.0/.well-known/openid-configuration"

[auth.google]
client_id = "..."
client_secret = "..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Option B (quick start, local use): a shared password instead of [auth].
# Delete the whole [auth] section above and set:
#   [access]
#   password_sha256 = "<output of: python -c \"import hashlib; print(hashlib.sha256(b'your password').hexdigest())\">"
#   password_role = "admin"
